+	static bool Add_Auth_Token(const std::vector<uint8_t>& payload) {
+		if (payload.size() != sizeof(hw_auth_token_t)) {
+			printf("Invalid GateKeeper auth token size\n");
+			return false;
+		}
+		hw_auth_token_t token;
+		memcpy(&token, payload.data(), sizeof(token));
+		HardwareAuthToken authToken;
+		authToken.timestamp.milliSeconds = betoh64(token.timestamp);
+		authToken.challenge = token.challenge;
+		authToken.userId = token.user_id;
+		authToken.authenticatorId = token.authenticator_id;
+		authToken.authenticatorType = static_cast<HardwareAuthenticatorType>(
+				betoh32(token.authenticator_type));
+		authToken.mac.assign(token.hmac, token.hmac + sizeof(token.hmac));
+		::ndk::SpAIBinder binder(AServiceManager_waitForService("android.security.authorization"));
+		auto service = aidl::android::security::authorization::IKeystoreAuthorization::fromBinder(binder);
+		if (!service) {
+			printf("Could not connect to keystore authorization service\n");
+			return false;
+		}
+		auto status = service->addAuthToken(authToken);
+		if (!status.isOk()) {
+			printf("Failed to add GateKeeper auth token\n");
+			return false;
+		}
+		return true;
+	}
+
+	static bool Authorize_Profile_Parent(const userid_t user_id, const std::string& handle,
+			const std::string& password) {
+		// lmi uses the QTI HIDL Gatekeeper, also used for its LSKF protector.
+		auto gatekeeper = android::hardware::gatekeeper::V1_0::IGatekeeper::getService();
+		if (!gatekeeper) {
+			printf("Could not connect to parent GateKeeper\n");
+			return false;
+		}
+		android::hardware::hidl_vec<uint8_t> handle_vec;
+		handle_vec.setToExternal((uint8_t*)handle.data(), handle.size());
+		android::hardware::hidl_vec<uint8_t> password_vec;
+		password_vec.setToExternal((uint8_t*)password.data(), password.size());
+		GKResponse response;
+		auto status = gatekeeper->verify(user_id, 0, handle_vec, password_vec,
+			[&response, user_id](const GatekeeperResponse& rsp) {
+				if (rsp.code >= android::hardware::gatekeeper::V1_0::GatekeeperStatusCode::STATUS_OK) {
+					response = GKResponse::ok({rsp.data.begin(), rsp.data.end()});
+				} else if (rsp.code == android::hardware::gatekeeper::V1_0::GatekeeperStatusCode::ERROR_RETRY_TIMEOUT) {
+					printf("Parent GateKeeper retry for user %u after %u ms\n", user_id, rsp.timeout);
+					response = GKResponse::retry(rsp.timeout);
+				} else {
+					response = GKResponse::error();
+				}
+			});
+		return status.isOk() && response.response_code() == GKResponseCode::OK &&
+			Add_Auth_Token(response.payload());
+	}
