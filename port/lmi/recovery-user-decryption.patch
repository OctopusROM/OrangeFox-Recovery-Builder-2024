+extern "C" bool Decrypt_Profile(const userid_t user_id) {
+	if (user_id == 0 || user_id > 9999)
+		return false;
+	std::string stored;
+	const std::string path = "/data/system/users/" + std::to_string(user_id) + "/gatekeeper.profile.key";
+	if (!android::base::ReadFileToString(path, &stored) || stored.size() <= 12 + 16) {
+		printf("Invalid tied profile lock file for user %u\n", user_id);
+		return false;
+	}
+	::ndk::SpAIBinder binder(AServiceManager_checkService("android.system.keystore2.IKeystoreService/default"));
+	auto keystore = ks2::IKeystoreService::fromBinder(binder);
+	if (!keystore)
+		return false;
+	ks2::KeyEntryResponse key;
+	auto status = keystore->getKeyEntry(android::keystore::keyDescriptor(
+		"profile_key_name_decrypt_" + std::to_string(user_id)), &key);
+	if (!status.isOk()) {
+		printf("Could not find parent-bound key for profile %u\n", user_id);
+		return false;
+	}
+	std::vector<uint8_t> nonce(stored.begin(), stored.begin() + 12);
+	std::vector<uint8_t> ciphertext(stored.begin() + 12, stored.end());
+	auto params = keymint::AuthorizationSetBuilder()
+		.Authorization(keymint::TAG_ALGORITHM, keymint::Algorithm::AES)
+		.Authorization(keymint::TAG_BLOCK_MODE, keymint::BlockMode::GCM)
+		.Padding(keymint::PaddingMode::NONE)
+		.Authorization(keymint::TAG_PURPOSE, keymint::KeyPurpose::DECRYPT)
+		.Authorization(keymint::TAG_NONCE, nonce)
+		.Authorization(keymint::TAG_MAC_LENGTH, 128);
+	ks2::CreateOperationResponse operation;
+	status = key.iSecurityLevel->createOperation(key.metadata.key, params.vector_data(), false, &operation);
+	if (!status.isOk()) {
+		printf("Parent authorization unavailable for profile %u\n", user_id);
+		return false;
+	}
+	std::optional<std::vector<uint8_t>> plaintext;
+	status = operation.iOperation->finish(ciphertext, {}, &plaintext);
+	if (!status.isOk() || !plaintext || plaintext->empty()) {
+		printf("Could not decrypt tied profile credential for user %u\n", user_id);
+		return false;
+	}
+	std::string password(plaintext->begin(), plaintext->end());
+	OPENSSL_cleanse(plaintext->data(), plaintext->size());
+	const bool result = Decrypt_User_Synth_Pass(user_id, password);
+	OPENSSL_cleanse(password.data(), password.size());
+	return result;
+}
